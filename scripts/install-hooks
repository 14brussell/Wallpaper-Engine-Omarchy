#!/usr/bin/env bash
# Install Omarchy hooks so Wallpaper Engine restores on boot and tracks theme bgs.
# Hook bodies live in hooks/*.sh. Installed hooks are tiny wrapper shims that
# resolve the current canonical source at execution time, so a normal Omarchy
# plugin update cannot leave stale copied hook logic behind.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
action=${1:-install}
HOOKS_ROOT="${WE_HOOKS_ROOT:-$HOME/.config/omarchy/hooks}"
MARKER="# wallpaper-engine-omarchy"

POST_BOOT="$HOOKS_ROOT/post-boot.d/50-wallpaper-engine"
THEME_SET="$HOOKS_ROOT/theme-set.d/50-wallpaper-engine"

usage() {
  echo "Usage: install-hooks [install|remove]" >&2
  exit 1
}

# Install a marker-bearing wrapper that forwards every argument to the current
# canonical hook source. printf %q makes paths containing shell metacharacters
# safe to embed in the wrapper.
write_hook() {
  local src=$1 dest=$2
  [[ -f $src ]] || {
    echo "Missing hook source: $src" >&2
    exit 1
  }
  mkdir -p "$(dirname -- "$dest")"
  local tmp quoted_src
  tmp=$(mktemp "${dest}.tmp.XXXXXX")
  printf -v quoted_src '%q' "$src"
  {
    echo "#!/usr/bin/env bash"
    echo "$MARKER"
    echo "set -euo pipefail"
    printf 'HOOK_SOURCE=%s\n' "$quoted_src"
    echo 'if [[ ! -f $HOOK_SOURCE ]]; then'
    echo '  printf '\''Wallpaper Engine hook source is missing: %s\n'\'' "$HOOK_SOURCE" >&2'
    echo '  exit 1'
    echo 'fi'
    echo 'exec "$HOOK_SOURCE" "$@"'
  } >"$tmp"
  chmod +x "$tmp"
  mv "$tmp" "$dest"
}

install_hooks() {
  write_hook "$ROOT/hooks/post-boot.sh" "$POST_BOOT"
  write_hook "$ROOT/hooks/theme-set.sh" "$THEME_SET"
  "$ROOT/hooks/monitor-watch.sh" --ensure >/dev/null 2>&1 || true

  echo "Installed hooks:"
  echo "  $POST_BOOT"
  echo "  $THEME_SET"
}

remove_hooks() {
  local hook
  for hook in "$POST_BOOT" "$THEME_SET"; do
    if [[ ! -e $hook && ! -L $hook ]]; then
      continue
    fi
    if [[ -f $hook ]] && grep -Fqx "$MARKER" "$hook"; then
      rm -f -- "$hook"
    else
      printf 'Preserved (not recognized as plugin-owned): %s\n' "$hook" >&2
    fi
  done
  echo "Removed wallpaper-engine hooks."
}

case "$action" in
  install) install_hooks ;;
  remove) remove_hooks ;;
  *) usage ;;
esac
